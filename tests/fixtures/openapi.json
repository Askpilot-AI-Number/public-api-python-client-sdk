      },
      "SubagentSourceOut": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id",
            "description": "Unique identifier of the subagent source. It's null when the type is platform_internal."
          },
          "name": {
            "type": "string",
            "title": "Name",
