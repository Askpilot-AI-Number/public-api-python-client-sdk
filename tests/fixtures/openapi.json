          "path"
        ],
        "title": "FileOut",
        "description": "A file that belongs to the workflow.\n\nThe response includes the name and location of the file, but not its\ncontent."
      },
      "OrganizationOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Unique identifier of the organization."
