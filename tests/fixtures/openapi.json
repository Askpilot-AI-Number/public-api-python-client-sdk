        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Unique identifier of the trigger."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Name of the trigger. It can be empty."
          },
          "is_active": {
            "type": "boolean",
